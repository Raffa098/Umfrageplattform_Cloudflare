/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'

# Skripte, Stile und Startseite bei jedem Laden auf Aktualisierung prüfen (sonst zeigt Safari nach einem Update teils alte Versionen)
/
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/datenschutz.html
  Cache-Control: no-cache
